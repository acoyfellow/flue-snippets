{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flue-snippet-ai-gateway",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI" },
  "migrations": [
    { "tag": "flue-2-class-FlueAiGatewayAgent", "new_sqlite_classes": ["FlueAiGatewayAgent"] }
  ],
  "vars": { "CLOUDFLARE_GATEWAY_ID": "jordan" }
}
