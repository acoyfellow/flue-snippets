{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flue-snippet-hyperdrive",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "migrations": [
    { "tag": "flue-class-FlueRegistry", "new_sqlite_classes": ["FlueRegistry"] },
    { "tag": "flue-class-FlueHyperdriveWorkflow", "new_sqlite_classes": ["FlueHyperdriveWorkflow"] }
  ],
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "REPLACE_HYPERDRIVE_ID" }]
}
