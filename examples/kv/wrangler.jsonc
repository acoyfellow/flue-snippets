{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flue-snippet-kv",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI" },
  "migrations": [
    { "tag": "flue-2-class-FlueKvAgent", "new_sqlite_classes": ["FlueKvAgent"] }
  ],
  "kv_namespaces": [{ "binding": "KV", "id": "REPLACE_KV_NAMESPACE_ID" }]
}
