{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flue-snippet-queues",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI" },
  "migrations": [
    { "tag": "flue-2-class-FlueQueuesAgent", "new_sqlite_classes": ["FlueQueuesAgent"] }
  ],
  "queues": {
    "producers": [{ "binding": "QUEUE", "queue": "replace-queue-name" }]
  }
}
