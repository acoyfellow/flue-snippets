{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flue-snippet-vectorize",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI" },
  "migrations": [
    { "tag": "flue-2-class-FlueVectorizeAgent", "new_sqlite_classes": ["FlueVectorizeAgent"] }
  ],
  "vectorize": [{ "binding": "VECTOR", "index_name": "replace-vectorize-index" }]
}
