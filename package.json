{
  "name": "flue-snippets",
  "version": "0.0.1",
  "private": true,
  "description": "Real, runnable Flue agents on Cloudflare. Each example shows one CF product; each recipe composes several. Every snippet ships an end-to-end test that deploys an ephemeral Worker, asserts, and tears it down.",
  "type": "module",
  "scripts": {
    "rx:lab-receipt": "bash recipes/lab-receipt/run-e2e.sh",
    "rx:do-session": "bash recipes/do-session/run-e2e.sh",
    "rx:do-governor": "bash recipes/do-governor/run-e2e.sh",
    "rx:lab-checkpoint": "bash recipes/lab-checkpoint/run-e2e.sh",
    "rx:ai-gateway": "bash recipes/ai-gateway/run-e2e.sh",
    "rx:gateway-lab": "bash recipes/gateway-lab/run-e2e.sh",
    "rx:github-triage": "bash recipes/github-triage/run-e2e.sh",
    "rx:chat-thinking": "bash recipes/chat-thinking/run-e2e.sh",
    "rx:virtual-sandbox": "bash recipes/virtual-sandbox/run-e2e.sh",
    "rx:mcp-client": "bash recipes/mcp-client/run-e2e.sh",
    "rx:dynamic-workflow": "bash recipes/dynamic-workflow/run-e2e.sh",
    "rx:event-trigger": "bash recipes/event-trigger/run-e2e.sh",
    "tpl:github-app": "bash templates/github-app/run-e2e.sh",
    "update": "bun scripts/update.ts",
    "check:update": "cd site && bun run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "ex:ai-gateway": "bash examples/ai-gateway/run-e2e.sh",
    "ex:browser-rendering": "bash examples/browser-rendering/run-e2e.sh",
    "ex:d1": "bash examples/d1/run-e2e.sh",
    "ex:durable-objects": "bash examples/durable-objects/run-e2e.sh",
    "ex:email-workers": "bash examples/email-workers/run-e2e.sh",
    "ex:hyperdrive": "bash examples/hyperdrive/run-e2e.sh",
    "ex:kv": "bash examples/kv/run-e2e.sh",
    "ex:queues": "bash examples/queues/run-e2e.sh",
    "ex:r2": "bash examples/r2/run-e2e.sh",
    "ex:vectorize": "bash examples/vectorize/run-e2e.sh",
    "ex:worker-loader": "bash examples/worker-loader/run-e2e.sh",
    "ex:workers-ai": "bash examples/workers-ai/run-e2e.sh",
    "ex:effect-hello": "bash examples/effect-hello/run-e2e.sh",
    "rx:computer-workspace": "bash recipes/computer-workspace/run-e2e.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/bun": "latest",
    "alchemy": "^0.93.7",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@acoyfellow/lab": "^0.0.3",
    "@cloudflare/puppeteer": "^1.1.0",
    "@cloudflare/think": "latest",
    "@octokit/core": "^7.0.6",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "agents": "^0.12.4",
    "gateproof": "latest",
    "postgres": "^3.4.9",
    "valibot": "^1.4.0",
    "workers-ai-provider": "^0.5.3",
    "zod": "^3.25.76"
  }
}
