{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flue-snippet-braintrust-trace",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI" },
  "migrations": [
    { "tag": "flue-2-class-FlueBraintrustTraceAgent", "new_sqlite_classes": ["FlueBraintrustTraceAgent"] }
  ],
  "vars": { "BRAINTRUST_PROJECT": "flue-snippets" }
}
