{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flue-snippet-lab-checkpoint",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "migrations": [
    { "tag": "flue-class-FlueRegistry", "new_sqlite_classes": ["FlueRegistry"] },
    {
      "tag": "flue-class-FlueLabCheckpointWorkflow",
      "new_sqlite_classes": ["FlueLabCheckpointWorkflow"]
    }
  ],
  "ai": { "binding": "AI" },
  "vars": { "LAB_URL": "REPLACE_LAB_URL" }
}
