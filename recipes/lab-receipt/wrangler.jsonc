{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flue-snippet-lab-receipt",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI" },
  "migrations": [
    { "tag": "flue-2-class-FlueLabReceiptAgent", "new_sqlite_classes": ["FlueLabReceiptAgent"] }
  ],
  "vars": { "LAB_URL": "REPLACE_LAB_URL" }
}
