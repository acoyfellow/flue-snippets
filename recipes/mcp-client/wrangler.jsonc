{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flue-snippet-mcp-client",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI" },
  "migrations": [
    { "tag": "flue-2-class-FlueMcpClientAgent", "new_sqlite_classes": ["FlueMcpClientAgent"] },
    { "tag": "app-class-ReverseServer", "new_sqlite_classes": ["ReverseServer"] }
  ],
  "durable_objects": { "bindings": [{ "name": "ReverseServer", "class_name": "ReverseServer" }] }
}
