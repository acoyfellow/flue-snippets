{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flue-snippet-virtual-sandbox",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI" },
  "migrations": [
    { "tag": "flue-2-class-FlueVirtualSandboxAgent", "new_sqlite_classes": ["FlueVirtualSandboxAgent"] }
  ],
  "r2_buckets": [{ "binding": "KB", "bucket_name": "replace-r2-bucket-name" }]
}
