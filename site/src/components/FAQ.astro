---
interface QA {
  q: string;
  a: string;
}

const items: QA[] = [
  {
    q: 'Do these agents run on Cloudflare?',
    a: 'Yes. Each test builds a Worker with Vite, deploys it with Wrangler, asserts against the live endpoint, then deletes the Worker. CI does the same. No mocks.',
  },
  {
    q: 'How does the build and the deploy work?',
    a: 'Vite builds each snippet. The flue() plugin finds each \'use agent\' module and writes dist/<name>/wrangler.json with the bindings and Durable Object migrations. Then wrangler deploy --config ships it.',
  },
  {
    q: 'Do I need any third-party API keys?',
    a: 'No. The examples use Workers AI. You need no OpenAI or Anthropic key. Check your Cloudflare plan before you run the full matrix.',
  },
  {
    q: 'Can I run one snippet only?',
    a: 'Yes. Use bun ex:<name> for examples, bun rx:<name> for recipes, and bun tpl:<name> for templates.',
  },
  {
    q: 'Where can Flue run?',
    a: 'Flue runs where TypeScript runs. This repository targets Cloudflare Workers. Flue also builds for Node.js, GitHub Actions, GitLab CI, and Daytona. The agent code stays the same.',
  },
];
---

<section>
  <h2>FAQ</h2>
  <dl class="faq">
    {
      items.map((item) => (
        <Fragment>
          <dt>{item.q}</dt>
          <dd>{item.a}</dd>
        </Fragment>
      ))
    }
  </dl>
</section>

<style>
  .faq {
    margin: 0;
    display: grid;
    gap: 1rem;
  }
  dt {
    font-weight: 600;
    color: var(--text);
  }
  dd {
    margin: 0.25rem 0 0;
    color: var(--muted);
  }
</style>
