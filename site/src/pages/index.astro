---
import '~/styles/global.css';
import Catalog from '~/components/Catalog.astro';
import FAQ from '~/components/FAQ.astro';
import { loadSnippets, type Snippet } from '~/lib/snippets';

const examples = await loadSnippets('examples');
const recipes = await loadSnippets('recipes');
const templates = await loadSnippets('templates');
const allSnippets: Snippet[] = [...examples, ...recipes, ...templates];

const slugsFromSmallestToLargestAgent = ['workers-ai', 'do-session', 'virtual-sandbox', 'mcp-client'];
const starters = slugsFromSmallestToLargestAgent
  .map((slug) => allSnippets.find((snippet) => snippet.slug === slug))
  .filter((snippet): snippet is Snippet => Boolean(snippet));

const description = `${allSnippets.length} Flue 2.0 agents on Cloudflare Workers. Each one ships real code and a deploy command.`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Flue 2.0 on Cloudflare</title>
    <meta name="description" content={description} />

    {/* Open Graph + Twitter card */}
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://flue.coey.dev/" />
    <meta property="og:title" content="Flue 2.0 on Cloudflare" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://flue.coey.dev/og/index.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Flue 2.0 on Cloudflare. Agents you can deploy today. Real code and real deploys."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Flue 2.0 on Cloudflare" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://flue.coey.dev/og/index.png" />
    <meta
      name="twitter:image:alt"
      content="Flue 2.0 on Cloudflare. Agents you can deploy today. Real code and real deploys."
    />
    <link rel="preload" href="/fonts/inter-400.woff2" as="font" type="font/woff2" crossorigin />
    <link
      rel="preload"
      href="/fonts/jetbrains-mono-500.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <main class="container">
      <section class="hero">
        <p class="marks">
          <a href="https://flueframework.com" aria-label="Flue">
            <img src="/logos/flue.svg" alt="Flue logo" width="28" height="28" />
          </a>
          <span class="plus" aria-hidden="true">+</span>
          <a href="https://developers.cloudflare.com/workers/" aria-label="Cloudflare Workers">
            <img src="/logos/cloudflare.svg" alt="Cloudflare logo" width="62" height="28" />
          </a>
        </p>
        <h1>Flue 2.0 snippets for Cloudflare</h1>
        <p class="lede">
          {allSnippets.length} agents you can deploy today. Each one builds with Vite, deploys a real
          Worker, asserts, then deletes it.
        </p>
        <p class="meta muted">
          <a href="https://github.com/acoyfellow/flue-snippets">Repo →</a>
        </p>
      </section>

      <Catalog snippets={allSnippets} />

      <section class="starters">
        <h2>New here? Start with these</h2>
        <p class="muted">Four snippets, smallest to largest.</p>
        <ol class="starter-list">
          {
            starters.map((snippet, index) => (
              <li>
                <a
                  href={`https://github.com/acoyfellow/flue-snippets/tree/main/${snippet.repoPath}`}
                >
                  <span class="step-number">{index + 1}</span>
                  <span class="starter-body">
                    <span class="starter-title">{snippet.title}</span>
                    <span class="starter-tagline muted">{snippet.tagline}</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
      </section>

      <FAQ />

      <footer class="footer muted">
        <p>
          <a href="https://github.com/acoyfellow/flue-snippets">Source</a>
          <span> · </span>
          <a href="https://flueframework.com">Flue</a>
          <span> · </span>
          <a href="https://developers.cloudflare.com/workers/">Cloudflare Workers</a>
          <span> · </span>
          <a href="https://coey.dev">coey.dev</a>
        </p>
      </footer>
    </main>
  </body>
</html>

<style>
  .marks {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 var(--space-3);
  }
  .marks img {
    display: block;
    height: 28px;
    width: auto;
  }
  .plus {
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .lede {
    max-width: 62ch;
    text-wrap: balance;
    margin-bottom: var(--space-2);
  }
  .meta {
    font-size: var(--text-sm);
    margin: 0;
  }
  .starters {
    margin-top: var(--space-7);
  }
  .starters h2 {
    margin-bottom: var(--space-2);
  }
  .starter-list {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
  .starter-list a {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--text);
  }
  .starter-list a:hover {
    background: var(--card-bg);
  }
  .step-number {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--muted);
    height: 1lh;
    display: flex;
    align-items: center;
  }
  .starter-body {
    display: grid;
    gap: 1px;
  }
  .starter-title {
    font-family: var(--font-mono);
    font-size: 0.9em;
    font-weight: 500;
  }
  .starter-tagline {
    font-size: var(--text-sm);
  }
  .footer {
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
    font-size: var(--text-sm);
  }
</style>
